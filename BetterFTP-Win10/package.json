{
  "name": "betterftp-win10",
  "version": "1.0.0",
  "description": "班级电脑 FTP 老师账号切换与文件管理工具（Win10 风格版）",
  "main": "out/main/index.js",
  "author": "BetterFTP",
  "license": "MIT",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "smoke": "electron-vite build && electron out/main/index.js --smoke",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "build:portable": "electron-vite build && electron-builder --win portable"
  },
  "dependencies": {
    "iconv-lite": "^0.7.3"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "electron-vite": "^3.1.0",
    "ftp-srv": "^4.0.4",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
